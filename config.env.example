# ============================================================
#  CTF Tarreo — configuración central
#  Sourced por todos los scripts (bash y python vía os.environ)
# ============================================================

# --- Número de equipos (bajable el día del evento) -----------
# Cambia solo este número para reducir/ampliar equipos.
NUM_TEAMS=5

# --- Niveles (orden secuencial) ------------------------------
# No cambiar sin ajustar deploy_level.sh (templates por nivel).
NUM_LEVELS=5

# --- Rutas ---------------------------------------------------
# BASE se autodetecta en cada script; estas son relativas a BASE.
#   BASE/cves/lvl<L>-<nombre>/   material de cada nivel
#   BASE/flags/team<N>/lvl<L>/flag.txt
#   BASE/instances/team<N>/lvl<L>/docker-compose.yml

# --- Red del evento ------------------------------------------
# IP del servidor del CTF (esta PC) en la red aislada del evento.
# Aparece en las instrucciones de conexión de cada reto en CTFd.
# El día del evento pon aquí la IP real (ej: 10.10.0.1).
SERVER_IP="${SERVER_IP:-127.0.0.1}"

# --- CTFd ----------------------------------------------------
# Repo CTFd ya clonado (NO se re-clona). Ajusta si lo mueves.
CTFD_REPO="${CTFD_REPO:-$HOME/CTFd}"     # ruta del repo CTFd en ESTE server
# URL de la API de CTFd (servicio 'ctfd' expuesto en 8000).
CTFD_URL="http://127.0.0.1:8000"
# Token de admin de CTFd. Lo genera AUTOMÁTICAMENTE bootstrap.sh (setup_ctfd_admin.py)
# y lo escribe aquí. Puedes también exportarlo en el entorno o pegarlo a mano:
CTFD_TOKEN="${CTFD_TOKEN:-}"            # lo genera bootstrap.sh

# Credenciales del admin de CTFd (las crea el bootstrap la primera vez).
# CÁMBIALAS antes de un evento real.
CTFD_ADMIN_USER="${CTFD_ADMIN_USER:-admin}"
CTFD_ADMIN_EMAIL="${CTFD_ADMIN_EMAIL:-admin@ctf.local}"
CTFD_ADMIN_PASSWORD="${CTFD_ADMIN_PASSWORD:-CHANGE_ME}"
# Modo de CTFd: "users" o "teams" (la promoción NO depende de esto; se identifica por flag).
CTFD_USER_MODE="${CTFD_USER_MODE:-users}"

# --- Esquema de puertos --------------------------------------
# HOST_PORT = PORT_BASE + (LVL*100) + TEAM     -> 8101..8505
PORT_BASE=8000
# Puerto host extra para el bind-shell de samba (lvl5):
#   SMB_BIND_HOST = SMB_BIND_BASE + (5*100) + TEAM  -> 9501..9505
SMB_BIND_BASE=9000

# Puertos INTERNOS de cada contenedor (no tocar).
#   lvl1 druid=8888  lvl2 laravel=80  lvl3 glassfish=4848(https)
#   lvl4 php2shell=80(nginx+fpm)  lvl5 samba=445(+6699 bind)
